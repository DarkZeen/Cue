	<!-- The scripting way in, alongside the registered global hotkey: anything
	     that can run `open cue://open` can raise the panel — Shortcuts.app, a
	     launcher, a script. Opening the app is not enough on its own, because
	     an agent app with no windows treats being opened as "show Settings". -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.cue.app.url</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cue</string>
			</array>
		</dict>
	</array>
	<key>NSHumanReadableCopyright</key>
	<string>Cue is available under the MIT License.</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
</dict>
